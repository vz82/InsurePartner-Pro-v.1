@model IEnumerable<InsurancePartnerApp.Models.Partner>

@{
    ViewData["Title"] = "Partners List";
    var successId = TempData["SuccessId"]?.ToString();
}

<div class="row mb-4">
    <div class="col-md-12">
        <h1>Insurance Company Partners</h1>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <a href="@Url.Action("Create", "Partner")" class="btn btn-primary">Add New Partner</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No partners found. <a href="@Url.Action("Create", "Partner")">Create one now</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Partner Number</th>
                    <th>Partner Type</th>
                    <th>Is Foreign</th>
                    <th>Gender</th>
                    <th>Policies</th>
                    <th>Total Amount (HRK)</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var partner in Model)
                {
                    var rowClass = int.TryParse(successId, out var successIdInt) && successIdInt == partner.Id ? "highlight-new" : "";
                    <tr class="@rowClass cursor-pointer" data-partner-id="@partner.Id" onclick="showPartnerDetails(@partner.Id)" style="cursor: pointer;">
                        <td>
                            @if (partner.HasHighRisk)
                            {
                                <span style="color: red; font-weight: bold;">*</span>
                            }
                            @partner.FullName
                        </td>
                        <td>@partner.PartnerNumber</td>
                        <td>@(partner.PartnerTypeId == 1 ? "Personal" : "Legal")</td>
                        <td>
                            @if (partner.IsForeign)
                            {
                                <span class="badge badge-info">Yes</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">No</span>
                            }
                        </td>
                        <td>@partner.Gender</td>
                        <td>@partner.PolicyCount</td>
                        <td>@partner.TotalPolicyAmount.ToString("N2")</td>
                        <td>@partner.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-info" onclick="showAddPolicyModal(@partner.Id); event.stopPropagation();">Add Policy</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Partner Details Modal -->
<div class="modal fade" id="partnerDetailsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="partnerNameTitle"></h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="partnerDetailsContent">
                <!-- Content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Policy Modal -->
<div class="modal fade" id="addPolicyModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Policy</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <form id="addPolicyForm" method="POST" onsubmit="return submitPolicy(event)">
                <div class="modal-body">
                    <input type="hidden" id="partnerId" name="partnerId" />
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="shelfNumber">Shelf Number (10-15 characters):</label>
                        <input type="text" class="form-control" id="shelfNumber" name="shelfNumber" required minlength="10" maxlength="15" />
                    </div>
                    <div class="form-group">
                        <label for="policyAmount">Policy Amount (HRK):</label>
                        <input type="number" class="form-control" id="policyAmount" name="policyAmount" step="0.01" required min="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Policy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showPartnerDetails(partnerId) {
            $.ajax({
                url: '@Url.Action("GetPartnerDetails", "Partner")' + '?id=' + partnerId,
                type: 'GET',
                success: function (data) {
                    const partner = data.partner;
                    let html = '<div class="row">';
                    html += '<div class="col-md-6"><strong>Full Name:</strong> ' + partner.fullName + '</div>';
                    html += '<div class="col-md-6"><strong>Gender:</strong> ' + partner.gender + '</div>';
                    html += '<div class="col-md-6"><strong>Partner Number:</strong> ' + partner.partnerNumber + '</div>';
                    html += '<div class="col-md-6"><strong>Partner Type:</strong> ' + partner.partnerType + '</div>';
                    html += '<div class="col-md-6"><strong>Is Foreign:</strong> ' + (partner.isForeign ? 'Yes' : 'No') + '</div>';
                    html += '<div class="col-md-6"><strong>External Code:</strong> ' + partner.externalCode + '</div>';
                    if (partner.address) {
                        html += '<div class="col-md-12"><strong>Address:</strong> ' + partner.address + '</div>';
                    }
                    if (partner.croatianPIN) {
                        html += '<div class="col-md-6"><strong>Croatian PIN:</strong> ' + partner.croatianPIN + '</div>';
                    }
                    html += '<div class="col-md-6"><strong>Created By:</strong> ' + partner.createdByUser + '</div>';
                    html += '<div class="col-md-6"><strong>Created At:</strong> ' + new Date(partner.createdAtUtc).toLocaleString() + '</div>';
                    html += '<div class="col-md-6"><strong>Policies:</strong> ' + partner.policyCount + '</div>';
                    html += '<div class="col-md-6"><strong>Total Amount:</strong> ' + partner.totalPolicyAmount.toFixed(2) + ' HRK</div>';
                    if (partner.hasHighRisk) {
                        html += '<div class="col-md-12"><div class="alert alert-warning mt-2"><strong>⚠ High Risk:</strong> More than 5 policies or total amount > 5,000 HRK</div></div>';
                    }
                    
                    if (data.policies.length > 0) {
                        html += '<div class="col-md-12 mt-3"><h6>Policies:</h6><ul class="list-group">';
                        data.policies.forEach(function (policy) {
                            html += '<li class="list-group-item">Shelf: ' + policy.shelfNumber + ' - Amount: ' + policy.policyAmount.toFixed(2) + ' HRK</li>';
                        });
                        html += '</ul></div>';
                    }
                    html += '</div>';
                    
                    $('#partnerNameTitle').text(partner.fullName);
                    $('#partnerDetailsContent').html(html);
                    $('#partnerDetailsModal').modal('show');
                },
                error: function () {
                    alert('Error loading partner details');
                }
            });
        }

        function showAddPolicyModal(partnerId) {
            $('#partnerId').val(partnerId);
            $('#addPolicyForm')[0].reset();
            $('#addPolicyModal').modal('show');
        }

        function submitPolicy(event) {
            event.preventDefault();
            const partnerId = $('#partnerId').val();
            const shelfNumber = $('#shelfNumber').val();
            const policyAmount = $('#policyAmount').val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("AddPolicy", "Partner")',
                type: 'POST',
                data: {
                    partnerId: partnerId,
                    shelfNumber: shelfNumber,
                    policyAmount: policyAmount,
                    __RequestVerificationToken: token
                },
                success: function (data) {
                    if (data.success) {
                        alert(data.message);
                        $('#addPolicyModal').modal('hide');
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                },
                error: function () {
                    alert('Error adding policy');
                }
            });
            return false;
        }
    </script>
}