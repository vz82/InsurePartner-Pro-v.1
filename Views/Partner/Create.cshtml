@model InsurancePartnerApp.Models.Partner

@{
    ViewData["Title"] = "Create Partner";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1>Add New Partner</h1>
        <hr />

        <form asp-action="Create" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="FirstName">First Name *</label>
                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" required />
                <small class="form-text text-muted">2-255 characters</small>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName">Last Name *</label>
                <input asp-for="LastName" class="form-control" placeholder="Enter last name" required />
                <small class="form-text text-muted">2-255 characters</small>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address">Address</label>
                <input asp-for="Address" class="form-control" placeholder="Enter address" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PartnerNumber">Partner Number (20 digits) *</label>
                <input asp-for="PartnerNumber" class="form-control" placeholder="00000000000000000000" required pattern="^\d{20}$" />
                <small class="form-text text-muted">Must be exactly 20 digits</small>
                <span asp-validation-for="PartnerNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CroatianPIN">Croatian PIN (OIB)</label>
                <input asp-for="CroatianPIN" class="form-control" placeholder="Optional" />
                <span asp-validation-for="CroatianPIN" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PartnerTypeId">Partner Type *</label>
                <select asp-for="PartnerTypeId" class="form-control" required>
                    <option value="">Select a type</option>
                    <option value="1">Personal</option>
                    <option value="2">Legal</option>
                </select>
                <span asp-validation-for="PartnerTypeId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IsForeign">Is Foreign *</label>
                <div class="custom-control custom-checkbox">
                    <input asp-for="IsForeign" type="checkbox" class="custom-control-input" />
                    <label class="custom-control-label" for="IsForeign">Check if this is a foreign partner</label>
                </div>
                <span asp-validation-for="IsForeign" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ExternalCode">External Code (10-20 alphanumeric) *</label>
                <input asp-for="ExternalCode" class="form-control" placeholder="Unique code" required minlength="10" maxlength="20" />
                <small class="form-text text-muted">Must be unique, 10-20 characters</small>
                <span asp-validation-for="ExternalCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Gender">Gender (M/F/N) *</label>
                <select asp-for="Gender" class="form-control" required>
                    <option value="">Select gender</option>
                    <option value="M">Male (M)</option>
                    <option value="F">Female (F)</option>
                    <option value="N">Not Specified (N)</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CreatedByUser">Created By User (Email) *</label>
                <input asp-for="CreatedByUser" class="form-control" placeholder="user@example.com" required type="email" />
                <small class="form-text text-muted">Must be a valid email address</small>
                <span asp-validation-for="CreatedByUser" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg">Save Partner</button>
                <a href="@Url.Action("Index", "Partner")" class="btn btn-secondary btn-lg">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            window.addEventListener('load', function () {
                var forms = document.querySelectorAll('.needs-validation');
                var validation = Array.prototype.filter.call(forms, function (form) {
                    form.addEventListener('submit', function (event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}